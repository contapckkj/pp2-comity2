# Copie para .env e ajuste. O arquivo .env NÃO deve ir para o Git.

# --- Servidor ---
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
# Quantos proxies reversos (nginx, Caddy, Cloudflare…) ficam na frente do app.
# 0 = nenhum (acesso direto). Com proxy, use 1 para ler o IP real do cliente.
TRUST_PROXY=0

# --- Cookie de sessão ---
# Em produção (HTTPS) deixe como true. Só use false em teste local sem HTTPS.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# --- Dados da empresa (aparecem no site) ---
COMPANY_NAME=P2 Automações
# WhatsApp com DDI + DDD + número, só dígitos. Ex.: 5562999999999
WHATSAPP_NUMBER=
CONTACT_EMAIL=

# --- Banco e fuso ---
DB_PATH=data/p2.sqlite
APP_TIMEZONE=America/Sao_Paulo
